{% extends "../base.p2" %}

{% block title %}Unauthorized{% endblock %}

{% block content %}
<div class="foreground box">
  <h1>Unauthorized</h1>
  <br />
  <hr />
  {% if user.Identity %}
  <p>You do not have permission to access this page. The required permission is <code>{{ perm }}</code>.</p>
  {% else %}
  <p>Please log in to access this page. The required permission is <code>{{ perm }}</code>.</p>
  <br />
  <div class="flex-container flex-center">
    <a class="flex-item button" href="/login">Login</a>
  </div>
  {% endif %}
  <br />
  <div class="flex-container flex-center">
    <a class="flex-item button" href="/">Back to Home</a>
  </div>
</div>
{% endblock %}
