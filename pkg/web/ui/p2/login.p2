<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Login | Gizmo Gameday{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
    <link href="/static/css/theme.css" rel="stylesheet">
    {% block head %}
    {% endblock %}
  </head>
  <body>
    <section class="hero is-fullheight">
      <div class="hero-body">
        <div class="container">
          <div class="columns is-centered is-vcentered">
            <div class="column is-5">
              <div class="box has-text-centered">
                <form method="POST">
                  <div class="field">
                    <label class="label" for="username">Username:</label>
                    <div class="control is-large">
                      <input class="input is-large" type="text" name="username" />
                    </div>
                  </div>

                  <div class="field">
                    <label class="label" for="password">Password:</label>
                    <div class="control is-large">
                      <input class="input is-large" type="password" name="password" />
                    </div>
                  </div>

                  <div class="field">
                    <div class="control">
                      <button class="button is-primary is-fullwidth" type="submit">Authenticate</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
    </section>
  </body>
</html>
