<div id="nav" class="foreground flex-container flex-row noprint">
  <div class="flex-item">
    <span id="logomark">Gameday</span>
  </div>
  <div class="flex-item flex-max">
    <nav>
      {% for element in navElements %}
      <div class="nav-container">
        <div class="nav-header">{{ element.Text }}</div>
        <div class="nav-dropdown">
          {% for child in element.Children %}
          <a class="nav-item" href="{{ child.Target }}">{{ child.Text }}</a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </nav>
  </div>
  <div class="flex-item">
    {% if user.Identity %}
    <a href="/logout" style="text-decoration: none; color: black;">Logout ({{ user.Identity }})</a>
    {% else %}
    <a href="/login">Login</a>
    {% endif %}
  </div>
</div>
