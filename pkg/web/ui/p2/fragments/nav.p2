<div class="navbar noprint" role="navigation">
  <div class="navbar-brand">
    <div class="navbar-item">
      <span id="logomark">Gameday</span>
    </div>
  </div>
  <div class="navbar-start">
    {% for element in navElements %}
    <div class="navbar-item has-dropdown is-hoverable">
      <div class="navbar-item">{{ element.Text }}</div>
      <div class="navbar-dropdown">
        {% for child in element.Children %}
        <a class="navbar-item" href="{{ child.Target }}"{% if child.Blank %} target="_blank"{% endif %}>{{ child.Text }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="navbar-end buttons">
    <div class="navbar-item">
      <label class="switch" for="theme-toggle" title="Toggle dark mode">
        <input type="checkbox" id="theme-toggle">
        <span class="switch-track"><span class="switch-thumb"></span></span>
        <span class="switch-icon" aria-hidden="true">
          <svg class="icon-sun" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 18a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1ZM3 11a1 1 0 1 0 0 2h2a1 1 0 1 0 0-2H3Zm16 0a1 1 0 1 0 0 2h2a1 1 0 1 0 0-2h-2ZM5.6 6.6a1 1 0 0 1 0-1.4l1.4-1.4a1 1 0 1 1 1.4 1.4L7 6.6a1 1 0 0 1-1.4 0Zm11.4 11.4a1 1 0 0 1 0-1.4l1.4-1.4a1 1 0 1 1 1.4 1.4L18.4 18a1 1 0 0 1-1.4 0ZM6.6 18.4a1 1 0 0 1-1.4 0L3.8 17a1 1 0 1 1 1.4-1.4L6.6 17a1 1 0 0 1 0 1.4ZM18 7a1 1 0 0 1-1.4 0L15.2 5.6a1 1 0 1 1 1.4-1.4L18 5.6A1 1 0 0 1 18 7Z"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
          </svg>
        </span>
      </label>
    </div>
    <div class="navbar-item">
      {% if user.Identity %}
      <a href="/logout" class="button">Logout ({{ user.Identity }})</a>
      {% else %}
      <a href="/login" class="button">Login</a>
      {% endif %}
    </div>
  </div>
</div>
