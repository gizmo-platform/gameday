{% extends "../../base.p2" %}

{% block title %}Delete Local User{% endblock %}

{% block content %}
  <div class="box">
    <div class="is-flex is-justify-content-center">
      <div>
        <form method="POST">
          <p>Are you sure you want to delete the user "{{ user.Login }}"?  This action cannot be un-done!</p>
          <div class="is-flex is-justify-content-center">
            <div class="field is-grouped">
              <div class="control">
                <a class="button" href="../">Cancel</a>
              </div>

              <div class="control">
                <button type="submit" class="button is-danger">Delete</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
