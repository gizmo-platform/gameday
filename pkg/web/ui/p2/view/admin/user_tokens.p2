{% extends "../../base.p2" %}

{% block title %}API Tokens{% endblock %}

{% block content %}
<div class="box">
  <div class="is-flex is-justify-content-center">
    <h2 class="title is-4">API Tokens for {{ user.Login }}</h2>
  </div>
  <hr />
  <div class="is-flex is-justify-content-center">
    <div>
      <form method="POST" action="/admin/user/{{ user.ID }}/tokens">
        <div class="field">
          <label class="label">Label</label>
          <div class="control">
            <input class="input" type="text" name="label" placeholder="e.g. CI script" />
          </div>
        </div>
        <div class="field">
          <div class="control">
            <button type="submit" class="button is-primary">Create Token</button>
          </div>
        </div>
      </form>
      <hr />
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Label</th>
            <th>Prefix</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for token in tokens %}
          <tr>
            <td>{{ token.ID }}</td>
            <td>{{ token.Label }}</td>
            <td><code>{{ token.Prefix }}&hellip;</code></td>
            <td>{{ token.CreatedAt | date:"2006-01-02 15:04" }}</td>
            <td class="flex-container flex-row">
              <form method="POST" action="/admin/user/{{ user.ID }}/tokens/{{ token.ID }}/delete">
                <button type="submit" class="button is-danger">Delete</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="is-flex is-justify-content-center">
        <a class="button" href="/admin/user/">Back to Users</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
