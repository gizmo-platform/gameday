{% extends "../../base.p2" %}

{% block title %}Profile Permissions{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <p class="mb-4">
        Use this page to modify the permissions for a given profile.
      </p>
      <form method="POST">
        {% for group in permGroups %}
          <fieldset class="box">
            <legend class="label">{{ group.Module | title }}</legend>
            <div class="checkboxes">
              {% for permission in group.Permissions %}
                {% set perm = permission.Module + ":" + permission.Grant %}
                <label class="checkbox">
                  <input type="checkbox" name="permissions" value="{{ permission.ID }}" {% if pprofile | hasPermissionExact:perm %}checked{% endif %} />
                  {{ permission.Grant | title }}
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
        <button type="submit" class="button is-primary">Save Permissions</button>
      </form>
    </div>
  </div>
{% endblock %}
