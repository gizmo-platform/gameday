{% extends "../../base.p2" %}

{% block title %}Profile Permissions{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <p>
        Use this page to modify the permissions for a given profile.
        Select multiple items by holding Control/Option on your
        keyboard while clicking on items in the list.
      </p>
      <form method="POST">
        <div class="field">
          <div class="control">
            <span class="select is-multiple">
              <select name="permissions" multiple>
                {% for permission in permissions %}
                  {% set perm = permission.Module + ":" + permission.Grant %}
                  <option value="{{ permission.ID }}" {% if pprofile | hasPermissionExact:perm %}selected{% endif %}>{{ permission.Module }} | {{ permission.Grant }}</option>
                {% endfor %}
              </select>
            </span>
          </div>
        </div>        
        <button type="submit" class="button is-primary">Save Permissions</button>
      </form>
    </div>
  </div>
{% endblock %}
