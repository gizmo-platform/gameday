{% extends "../../base.p2" %}

{% block title %}Create User{% endblock %}

{% block content %}
<div class="box is-flex is-justify-content-center">
  <div>
    <p>Use the form below to reset a local user's password.</p>
    <form method="POST">
      <div class="control">
        <label class="label" for="secret">Password</label>
        <div class="control">
          <input class="input" type="password" name="secret" />
        </div>
      </div>

      <div class="control">
        <button class="button is-primary is-fullwidth" type="submit">Reset Password</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
