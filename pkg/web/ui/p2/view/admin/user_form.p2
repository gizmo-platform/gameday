{% extends "../../base.p2" %}

{% block title %}Create User{% endblock %}

{% block content %}
<div class="foreground box">
  <div class="flex-container flex-row flex-center">
    <div class="flex-item">
      <form method="POST">
        <table>
          <tr>
            <td><label for="login">Login Name</label></td>
            <td><input type="text" name="login" value="{{ user.Login }}" /></td>
          </tr>
          <tr>
            <td><label for="secret">Password</label></td>
            <td><input type="password" name="secret" /></td>
          </tr>
          <tr>
            <td colspan="2" class="center"><input type="submit" /></td>
          </tr>
      </form>
    </div>
  </div>
</div>
{% endblock %}
