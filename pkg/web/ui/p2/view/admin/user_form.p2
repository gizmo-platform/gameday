{% extends "../../base.p2" %}

{% block title %}Create User{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <form method="POST">
      <div class="field">
        <label class="label" for="login">Login Name</label>
        <div class="control">
          <input class="input" type="text" name="login" value="{{ user.Login }}" />
        </div>
      </div>

      <div class="field">
        <label class="label" for="secret">Password</label>
        <div class="control">
          <input class="input" type="password" name="secret" />
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button type="submit" class="button is-primary is-fullwidth">Create User</button>
        </div>
      </div>
    </form>
  </div>
{% endblock %}
