{% extends "../../base.p2" %}

{% block title %}BEST Scores{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <p>Below is a list of the external scores for all teams.</p>
      <br />
      <hr />

      <table class="table">
        <tr>
          <th>Number</th>
          <th>Name</th>
          <th>Division</th>
          <th>Region</th>
          <th class="has-text-right">Notebook</th>
          <th class="has-text-right">Marketing</th>
          <th class="has-text-right">Poster</th>
          <th class="has-text-right">Video</th>
        </tr>
        {% for score in scores %}
          <tr>
            <td>{{ score.Team.Number }}</td>
            <td>{{ score.Team.Name }}</td>
            <td>{{ score.Team.Division.Name }}</td>
            <td>{{ score.Team.Region }}</td>
            {% if score.Score %}
              <td class="has-text-right">{{ score.Score.Notebook|floatformat:2 }}</td>
            <td class="has-text-right">{{ score.Score.Marketing|floatformat:2 }}</td>
            <td class="has-text-right">{{ score.Score.Poster|floatformat:2 }}</td>
            <td class="has-text-right">{{ score.Score.Video|floatformat:2 }}</td>
          {% else %}
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          {% endif %}
          </tr>
          {% empty %}
          <tr>
            <td colspan="8">No scores recorded.</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
</div>
{% endblock %}
