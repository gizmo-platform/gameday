{% extends "../../base.p2" %}

{% block title %}BEST Scores{% endblock %}

{% block head %}
    <link href="/static/css/scores.css" rel="stylesheet">
{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <p>Click a score to edit it in place; press Enter to save. Leave the field empty to clear it.</p>
      <br />
      <hr />

      <table class="table">
        <tr>
          <th>Number</th>
          <th>Name</th>
          <th>Division</th>
          <th>Region</th>
          {% for c in score_types %}
          <th class="has-text-right" title="Max {{ c.Max }}">{{ c.Name }}</th>
          {% endfor %}
          <th class="has-text-right">Total</th>
        </tr>
        {% for row in scores %}
          <tr>
            <td>{{ row.Team.Number }}</td>
            <td>{{ row.Team.Name }}</td>
            <td>{{ row.Team.Division.Name }}</td>
            <td>{{ row.Team.Region }}</td>
            {% for c in row.Cells %}
            <td class="has-text-right{% if c.Saved %} score-saved{% endif %}">
              <form method="post" action="{{ c.Action }}" class="score-form">
                <input
                  class="input is-small score-input"
                  type="number"
                  name="value"
                  step="0.01"
                  min="0"
                  max="{{ c.Max }}"
                  {% if c.Value %}value="{{ c.ValueFormatted }}"{% endif %}
                  placeholder="—"
                  onfocus="this.select()"
                >
              </form>
            </td>
            {% endfor %}
            <td class="has-text-right">{% if row.Total %}{{ row.Total|floatformat:2 }}{% else %}—{% endif %}</td>
          </tr>
          {% empty %}
          <tr>
            <td colspan="9">No teams found.</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
{% endblock %}
