{% extends "../../base.p2" %}

{% block title %}BEST Scores{% endblock %}

{% block content %}
<div class="foreground box">
  <p>Below is a list of the external scores for all teams.</p>
  <br />
  <hr />

  <div class="flex-container flex-center">
    <table class="flex-item flex-max">
      <tr>
        <th>Number</th>
        <th>Name</th>
        <th>Division</th>
        <th>Region</th>
        <th style="text-align: right;">Notebook</th>
        <th style="text-align: right;">Marketing</th>
        <th style="text-align: right;">Poster</th>
        <th style="text-align: right;">Video</th>
      </tr>
      {% for score in scores %}
      <tr>
        <td>{{ score.Team.Number }}</td>
        <td>{{ score.Team.Name }}</td>
        <td>{{ score.Team.Division.Name }}</td>
        <td>{{ score.Team.Region }}</td>
        {% if score.Score %}
        <td style="text-align: right;">{{ score.Score.Notebook|floatformat:2 }}</td>
        <td style="text-align: right;">{{ score.Score.Marketing|floatformat:2 }}</td>
        <td style="text-align: right;">{{ score.Score.Poster|floatformat:2 }}</td>
        <td style="text-align: right;">{{ score.Score.Video|floatformat:2 }}</td>
        {% else %}
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        {% endif %}
      </tr>
      {% empty %}
      <tr>
        <td colspan="8">No scores recorded.</td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
{% endblock %}
