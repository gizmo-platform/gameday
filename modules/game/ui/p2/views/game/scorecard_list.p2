{% extends "../../base.p2" %}

{% block title %}Scorecards{% endblock %}

{% block content %}
<div class="foreground box">
  <div>
    <form>
      <fieldset>
        <legend>Filter Scorecards</legend>
        <div class="flex-container flex-row flex-center">
          <div class="flex-item">
            <fieldset class="flex-container flex-column">
            <legend>Phase</legend>
            {% for phase in available_phases %}
            <div>
              <label>
                <input type="checkbox"
                       name="phase_id"
                       value="{{ phase.ID }}"
                       {% if phase.ID in filter.Phases %}checked{% endif %}
                       >
                {{ phase.Name|capfirst }}
              </label>
            </div>
            {% endfor %}
            </fieldset>
          </div>

          <div class="flex-item">
            <fieldset class="flex-container flex-column">
            <legend>Field</legend>
            {% for field in available_fields %}
            <div>
              <label>
                <input type="checkbox"
                       name="field_id"
                       value="{{ field.ID }}"
                       {% if field.ID in filter.Fields %}checked{% endif %}
                       >
                {{ field.Name|capfirst }}
              </label>
            </div>
            {% endfor %}
            </fieldset>
          </div>

          <div class="flex-item">
            <fieldset class="flex-container flex-column">
            <legend>Position</legend>
            {% for position in available_positions %}
            <div>
              <label>
                <input type="checkbox"
                       name="position_id"
                       value="{{ position.ID }}"
                       {% if position.ID in filter.Positions %}checked{% endif %}
                       >
                {{ position.Name|capfirst }}
              </label>
            </div>
            {% endfor %}
            </fieldset>
          </div>

          <div class="flex-item">
            <fieldset class="flex-container flex-column">
              <legend>Match State</legend>
              {% for state in available_states %}
              <div>
                <label>
                  <input type="checkbox"
                         name="state"
                         value="{{ state|integer }}"
                         {% if state in filter.States %}checked{% endif %}
                         >
                  {{ state.String()|capfirst }}
                </label>
              </div>
              {% endfor %}
            </fieldset>
          </div>
        </div>
        <div class="flex-container flex-row flex-center">
          <div class="flex-item flex-container flex-column">
            <label>
              <input type="radio" name="filter_action" value="save" checked />
              Save Filters
            </label>
            <label>
              <input type="radio" name="filter_action" value="clear" />
              Clear Filters
            </label>
          </div>

          <div class="flex-item">
            <input type="submit" value="Apply Filters" />
          </div>
        </div>
      </fieldset>
    </form>
  </div>

  <div class="flex-container flex-row flex-center">
    <table>
      <thead>
        <tr>
          <th>Phase</th>
          <th>Match</th>
          <th>Field</th>
          <th>Position</th>
          <th>Team</th>
          <th>State</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for placement in placements %}
        <tr style="background-color: #{% if forloop.Counter0%2 == 0 %}{{ placement.Position.Color1 }}{% else %}{{ placement.Position.Color2 }}{% endif %};">
          <td>{{ placement.Phase.Name|capfirst }}</td>
          <td>{{ placement.Match }}</td>
          <td>{{ placement.Field.Name }}</td>
          <td>{{ placement.Position.Name|capfirst }}</td>
          <td>{{ placement.Team.Name }}</td>
          <td>{{ placement.State.String()|capfirst }}</td>
          <td>
            <a class="button" href="scorecard/{{ placement.Phase.ID }}/{{ placement.Match }}/{{ placement.Field.ID }}/{{ placement.Position.ID }}">View</a>
          </td>
        </tr>
        {% empty%}
        <tr>
          <td colspan="7">No Matches for Current Filters</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
