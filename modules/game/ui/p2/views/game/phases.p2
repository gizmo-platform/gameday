{% extends "../../base.p2" %}

{% block title %}Game Configuration{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <table class="table">
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Division Aware</th>
          <th>Score Summation</th>
          <th>Schedule Type</th>
          <th>Actions</th>
        </tr>
        {% for phase in phases %}
          <tr class="{% if phase.Frozen %}dim-row{% endif %}">
            <td>{{ phase.ID }}</td>
            <td>{{ phase.Name }}</td>
            <td>{{ phase.DivisionAware | yesno | capfirst }}</td>
            <td>{{ phase.ScoreSummation }}</td>
            <td>{{ phase.ScheduleType }}</td>
            <td>
              <div class="buttons">
                {% if schedule[phase.ID] %}
                  <a class="button" href="schedule/phases/{{ phase.ID }}">View Schedule</a>
                  {% if !phase.Active and !phase.Frozen and (profile | hasPermission:"GAME:SCHEDULE") %}
                    <form method="POST" action="schedule/phases/{{ phase.ID }}/make-active">
                      <button type="submit" class="button">Activate</button>
                    </form>
                  {% endif %}
                  {% if profile | hasPermission:"GAME:SCHEDULE" %}
                    {% if !phase.HideScores %}
                      <form method="POST" action="schedule/phases/{{ phase.ID }}/make-scores-hidden">
                        <button type="submit" class="button">Hide Scores</button>
                      </form>
                    {% elif phase.HideScores %}
                      <form method="POST" action="schedule/phases/{{ phase.ID }}/make-scores-visible">
                        <button type="submit" class="button">Show Scores</button>
                      </form>
                    {% endif %}
                  {% endif %}
                  {% if phase.Active and completed[phase.ID] and not phase.Frozen and (profile | hasPermission:"GAME:SCHEDULE") %}
                    <form method="POST" action="schedule/phases/{{ phase.ID }}/make-frozen">
                      <button type="submit" class="button">Freeze</button>
                    </form>
                  {% endif %}
                {% elif canSchedule[phase.ID] and (profile | hasPermission:"GAME:SCHEDULE") %}
                  <a class="button" href="schedule/phases/{{ phase.ID }}/select-teams?st={{ phase.ScheduleType }}">Generate Schedule</a>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
{% endblock %}
