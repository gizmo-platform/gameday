{% extends "../../base.p2" %}

{% block title %}Game Configuration{% endblock %}

{% block content %}
<div class="foreground box flex-container flex-row flex-center">
  <div class="flex-item">
    <h2>Phase Configuration</h2>
    <table>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Division Aware</th>
        <th>Score Summation</th>
        <th>Schedule Type</th>
        <th>Actions</th>
      </tr>
      {% for phase in phases %}
      <tr class="{% if phase.Frozen %}dim-row{% endif %}">
        <td>{{ phase.ID }}</td>
        <td>{{ phase.Name }}</td>
        <td>{{ phase.DivisionAware | yesno | capfirst }}</td>
        <td>{{ phase.ScoreSummation }}</td>
        <td>{{ phase.ScheduleType }}</td>
        <td class="flex-container flex-row">
          {% if schedule[phase.ID] %}
          <a class="flex-item button" href="schedule/phases/{{ phase.ID }}">View Schedule</a>
          {% if !phase.Active and !phase.Frozen and (profile | hasPermission:"GAME:SCHEDULE") %}
          <form method="POST" action="schedule/phases/{{ phase.ID }}/make-active">
            <input class="flex-item button" type="submit" value="Activate" />
          </form>
          {% endif %}
          {% if phase.Active and completed[phase.ID] and not phase.Frozen and (profile | hasPermission:"GAME:SCHEDULE") %}
          <form method="POST" action="schedule/phases/{{ phase.ID }}/make-frozen">
            <input class="flex-item button" type="submit" value="Freeze" />
          </form>
          {% endif %}
          {% elif canSchedule[phase.ID] and (profile | hasPermission:"GAME:SCHEDULE") %}
          <a class="flex-item button" href="schedule/phases/{{ phase.ID }}/select-teams?st={{ phase.ScheduleType }}">Generate Schedule</a>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
{% endblock %}
