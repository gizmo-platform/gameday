{% extends "../../base.p2" %}

{% block title %}Game Setup{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <div class="content"><h1>Game Setup</h1></div>

      <p>The game setup file controls the field geometry, as well as the actual game scorecard setup.</p>
      <br />
      <form method="POST" enctype="multipart/form-data">
        <div class="field">
          <div class="control">
            <input class="input" type="file" name="game_config" />
          </div>
        </div>

        <div class="field">
          <div class="control">
            <button class="button is-primary is-fullwidth">Submit</button>
          </div>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
