{% extends "../../base.p2" %}

{% block title %}Fields{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <div class="is-flex is-justify-content-center">
        <a class="button is-primary" href="fields/add">Add Single</a>
      </div>
      <hr />

      <table class="table">
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Divisions</th>
          <th>Actions</th>
        </tr>
        {% for field in fields %}
          <tr>
            <td>{{ field.ID }}</td>
            <td>{{ field.Name }}</td>
            <td>
              {% for d in field.Divisions %}
                {{ d.Name }}{% if not forloop.last %}, {% endif %}
                {% empty %}
                —
              {% endfor %}
            </td>
            <td class="flex-container flex-row">
              <a class="flex-item button" href="fields/{{ field.ID }}/edit">Edit</a>
            </td>
          </tr>
          {% empty %}
          <tr>
            <td colspan="2">There are no fields. <a href="fields/add">Add One.</a></td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
</div>
{% endblock %}
