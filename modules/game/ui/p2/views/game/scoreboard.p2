{% extends "../../fullscreen.p2" %}

{% block title %}Phase Scoreboard{% endblock %}

{% block content %}
<div class="grid-center">
  <div class="foreground box bigbox flex-container flex-center">
    <div id="scorebox"></div>
  </div>
</div>

{% verbatim %}
<script id="tpl-board" type="x-tmpl-mustache">
  <table id="scoreboard">
    <thead>
      <tr>
        <th>Rank</th>
        <th>Score</th>
        <th>Team</th>
        <th>Division</th>
      </tr>
    </thead>
    <tbody>
      {{#scores}}
      <tr>
        <td> {{ Rank }}</td>
        <td> {{ Score }}</td>
        <td> {{ Team.Name }}</td>
        <td> {{ Team.Division }}</td>
      </tr>
      {{/scores}}
      {{^scores}}
      <tr><td colspan="4">No Scores for Phase</td></tr>
      {{/scores}}
    </tbody>
  </table>
</script>
{% endverbatim %}

<script defer src="/static/js/mustache.js"></script>
<script>
 const boardTemplate = document.getElementById('tpl-board').innerHTML;
 const boardContainer = document.getElementById('scorebox');

 const pageSize = 10;
 const dwellPerRow = 750;
 const minPageDwell = 2000;

 let currentPage = 1;
 let maxPage = 1;
 let cycles = 0;
 let maxCycles = 2;
 let pageDwell = 1000;

 async function fetchScores() {
     try {
         const resp = await fetch('/ui/mod/game/scoreboard/data' + window.location.search);
         if (!resp.ok) {
             throw new Error(`HTTP error! status: ${resp.status}`);
         }

         const data = await resp.json();

         if (data.hidden) {
         boardContainer.innerHTML = `<div class="hidden-message">${data.message || 'Scores are currently hidden for this phase.'}</div>`;
         return;
         }

         const rendered = Mustache.render(boardTemplate, {'scores': data});
         boardContainer.innerHTML = rendered;
         const tbl = document.getElementById('scoreboard');
         maxPage = Math.ceil(tbl.tBodies[0].rows.length / pageSize);
         changePage(0);
     } catch (error) {
         console.error('Error fetching data:', error);
     }
 }

 function changePage(page) {
     // Validate page number
     if (page < 1) page = 1;
     if (page > maxPage) page = maxPage;
     currentPage = page;

     const tbl = document.getElementById('scoreboard');
     const startIndex = (currentPage - 1) * pageSize;
     let endIndex = startIndex + pageSize;

     if (endIndex > tbl.tBodies[0].rows.length) {
         endIndex = tbl.tBodies[0].rows.length;
     }
     pageDwell = dwellPerRow * (endIndex - startIndex);
     if (pageDwell < minPageDwell) {
         pageDwell = minPageDwell;
     }

     // Hide all rows, then show only rows for the current page
     for (let i = 0; i < tbl.tBodies[0].rows.length; i++) {
         // Set display to 'none' to hide rows outside the current range
         tbl.tBodies[0].rows[i].style.display = (i >= startIndex && i < endIndex) ? '' : 'none';
     }
 }

 function cycleBoard() {
    const tbl = document.getElementById('scoreboard');
    if (!tbl) {
        /* Board is hidden — re-fetch and re-schedule the cycle so we
           pick up when scores become visible again. */
        setTimeout(fetchScores, 5000);
        setTimeout(cycleBoard, 5000);
        return;
    }

    if (currentPage + 1 > maxPage) {
        changePage(1);
    } else {
        changePage(currentPage+1);
    }
    if (cycles > maxCycles) {
        cycles = 0;
        fetchScores();
    }
    cycles++;

    setTimeout(cycleBoard, pageDwell)
}

 setTimeout(fetchScores, 100);
 setTimeout(cycleBoard, 2000);
</script>
{% endblock %}
