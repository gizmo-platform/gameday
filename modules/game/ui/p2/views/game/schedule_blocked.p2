{% extends "../../base.p2" %}

{% block title %}Schedule Generation Blocked{% endblock %}

{% block content %}
<div class="box">
  <div class="content"><h1>Schedule Generation Blocked</h1></div>
  <p>
    The advancement rules for <strong>{{ phase.Name }}</strong> cannot run
    yet, so this phase's schedule cannot be generated automatically.
  </p>
  <div class="notification is-warning">
    <ul>
      {% for reason in reasons %}
      <li>{{ reason }}</li>
      {% endfor %}
    </ul>
  </div>
  <p>
    Once the requirements above are met, return to the phase list and the
    Generate Schedule button will be available.
  </p>
  <hr />
  <div class="is-flex is-justify-content-center">
    <div class="buttons">
      <a class="button" href="{{ backPhases }}">Back to Phases</a>
      <a class="button is-warning" href="{{ overrideLink }}">Generate manually anyway</a>
    </div>
  </div>
</div>
{% endblock %}
