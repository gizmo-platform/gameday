{% extends "../../base.p2" %}

{% block title %}Field Form{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <form method="post">
      <div class="field">
        <label class="label" for="field_name">Name</label>
        <div class="control">
          <input class="input" type="text" name="field_name" value="{{ field.Name }}" />
        </div>
      </div>

      <div class="field">
        <label class="label">Divisions</label>
        <div class="checkboxes">
          {% for division in divisions %}
            <label class="checkbox">
              <input class="checkbox" type="checkbox" name="division_{{ division.ID }}"
                     {% for d in field.Divisions %}
                       {% if d.ID == division.ID %} checked{% endif %}
                     {% endfor %}>
                     {{ division.Name }}
            </label>
          {% endfor %}
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button type="submit" class="button is-primary is-fullwidth">Submit</button>
        </div>
      </div>
    </form>
  </div>
{% endblock %}
