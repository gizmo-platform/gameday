{% extends "../../base.p2" %}

{% block title %}Field Form{% endblock %}

{% block content %}
<div class="foreground box">
  <form method="post">
    <table>
      <tr>
        <th>Field</th>
        <th>Value</th>
      </tr>
      <tr>
        <td><label for="field_name">Name</label></td>
        <td><input type="text" name="field_name" value="{{ field.Name }}" /></td>
      </tr>
      <tr>
        <td><label>Divisions</label></td>
        <td>
          {% for division in divisions %}
          <label>
            <input type="checkbox" name="division_{{ division.ID }}"
              {% for d in field.Divisions %}
                {% if d.ID == division.ID %} checked{% endif %}
              {% endfor %}>
            {{ division.Name }}
          </label>
          {% empty %}
          <em>No divisions available</em>
          {% endfor %}
        </td>
      </tr>
      <tr>
        <td colspan="2"><input type="submit" /></td>
      </tr>
    </table>
  </form>
</div>
{% endblock %}
