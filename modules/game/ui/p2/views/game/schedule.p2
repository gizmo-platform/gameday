{% extends "../../base.p2" %}

{% block title %}Phase Schedule{% endblock %}

{% block content %}
<div class="foreground box flex-container flex-row flex-center">
  <div class="flex-item">
    <h2>Phase Schedule</h2>
    <div>
      <table>
        <tr>
          <td colspan="2"></td>
          {% for field in fields %}
          <th colspan="{{ positions | length }}">{{ field.Name }}</th>
          {% endfor %}
        </tr>
        <tr>
          <th>R</th>
          <th>M</th>
          {% for field in fields %}
          {% for position in positions %}
          <th>{{ position.Name | capfirst }}</th>
          {% endfor %}
          {% endfor %}
        </tr>
        {% for row in schedule %}
        <tr>
          <td>{{ row.Round }}</td>
          <td>{{ row.Match }}</td>
          {% for field in fields %}
          {% for position in positions %}
          {% if row.Placements[field.ID + "-" + position.ID] %}
          {% with team=row.Placements[field.ID + "-" + position.ID] %}
          <td style="background: #{% if row.Match%2 == 0 %}{{ position.Color1 }}{% else %}{{ position.Color2 }}{% endif %};">{{ team.Name }}</td>
          {% endwith %}
          {% else %}
          <td style="background: #{% if row.Match%2 == 0 %}{{ position.Color1 }}{% else %}{{ position.Color2 }}{% endif %};"></td>
          {% endif %}
          {% endfor %}
          {% endfor %}
        </tr>
        {% endfor %}
      </table>
    </div>
  </div>
</div>
{% endblock %}
