<div class="is-flex is-justify-content-space-between">
  {% for value in state.Values %}
  <div>
    <label for="{{ field_id }}_{{ value.VID }}">
      {{ value.Name }}
    </label>
    <input type="radio"
           id="{{ field_id }}_{{ value.VID }}"
           name="{{ field_id }}"
           value="{{ value.ID }}"
           data-points="{{ value.Points }}"
           data-present="{{ ScorecardData|key:field_id }}"
           {% if ScorecardData %}
           data-should-default="{{ (ScorecardData|key:field_id == 0) && value.Default }}"
           {% else %}
           data-should-default="{{ value.Default }}"
           {% endif %}
           {% if (ScorecardData|key:field_id == value.ID) || ((ScorecardData|key:field_id == 0) && value.Default) %}checked{% endif %}
           {% if edit_disable %}disabled{% endif %}
           />
  </div>
  {% endfor %}
</div>
