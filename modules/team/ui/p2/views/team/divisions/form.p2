{% extends "../../../base.p2" %}

{% block title %}Division Edit{% endblock %}

{% block content %}
<div class="foreground box flex-container flex-center">
  <form method="POST">
    <table class="flex-item">
      <tr>
        <th>Field</th>
        <th>Value</th>
      </tr>

      <tr>
        <td><label for="division_name">Division Name</label></td>
        <td><input type="text" name="division_name" value="{{ division.Name }}" /></td>
      </tr>

      <tr>
        <td colspan="2"><center><input type="submit" value="Save" /></center></td>
      </tr>
    </table>
  </form>
</div>
{% endblock %}
