{% extends "../../../base.p2" %}

{% block title %}Region Edit{% endblock %}

{% block content %}
  <div class="box">
    <form method="POST">
      <div class="field">
        <label for="region_name">Region Name</label>
        <div class="control">
          <input class="input" type="text" name="region_name" value="{{ region.Name }}" />
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button type="submit" class="button is-primary is-fullwidth">Save</button>
        </div>
      </div>
    </form>
  </div>
{% endblock %}
